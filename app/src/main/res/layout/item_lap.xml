<?xml version="1.0" encoding="utf-8"?>
<!-- one lap slice: label + split time + small total tag -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/glass_panel_small"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/lap_no"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/light_on_surface_variant"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lap_split"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:fontFamily="monospace"
        android:textColor="@color/light_on_surface"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/lap_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textColor="@color/light_on_surface_variant"
        android:textSize="11sp" />
</LinearLayout>
