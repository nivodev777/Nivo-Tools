<?xml version="1.0" encoding="utf-8"?>
<!-- Compass: header card + dial card (custom view) + degree readout -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- header card: dial emoji chip + title + sub -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_circle_chip"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:text="&#129517;"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/compass_title"
                        android:textColor="@color/light_on_surface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.8"
                        android:text="@string/compass_sub"
                        android:textColor="@color/light_on_surface_variant"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- dial card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/glass_panel"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="18dp">

                <com.nivodev.nivotools.ui.tools.compass.CompassDialView
                    android:id="@+id/dial"
                    android:layout_width="264dp"
                    android:layout_height="264dp" />

                <!-- degree + octant readout -->
                <TextView
                    android:id="@+id/dial_head_deg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="monospace"
                    android:text="0&#176;"
                    android:textColor="@color/light_on_surface"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dial_head_point"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.9"
                    android:text="N"
                    android:textColor="@color/light_on_surface_variant"
                    android:textSize="14sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/hint_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_solid_round"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:gravity="center"
                    android:text="@string/compass_hint"
                    android:textColor="@color/light_on_surface_variant"
                    android:textSize="12sp"
                    android:visibility="visible" />
            </LinearLayout>

            <Space
                android:layout_width="1dp"
                android:layout_height="6dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
