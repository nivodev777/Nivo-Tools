<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/reader_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- header card: file chip + name + open button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_circle_chip"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="&#128214;"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/reader_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:text="@string/reader_open"
                    android:textColor="@color/light_on_surface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/reader_type_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:maxLines="1"
                    android:text="@string/reader_type_hint"
                    android:textColor="@color/light_on_surface_variant"
                    android:textSize="11sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/btn_reader_files"
                android:layout_width="46dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_solid_round"
                android:gravity="center"
                android:text="&#128193;"
                android:textColor="@color/light_on_surface"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/btn_reader_open"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_ring_btn_off"
                android:gravity="center"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:text="@string/reader_open"
                android:textColor="@color/light_on_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/glass_panel"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/reader_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="26dp"
                android:alpha="0.65"
                android:gravity="center"
                android:text="@string/reader_empty"
                android:textColor="@color/light_on_surface_variant"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/reader_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4sp"
                android:textColor="@color/light_on_surface"
                android:textIsSelectable="true"
                android:textSize="16sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_reader_pages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/reader_font_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btn_font_down"
                    android:layout_width="46dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_solid_round"
                    android:gravity="center"
                    android:text="A&#8722;"
                    android:textColor="@color/light_on_surface_variant"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_font_up"
                    android:layout_width="46dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_solid_round"
                    android:gravity="center"
                    android:text="A+"
                    android:textColor="@color/light_on_surface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- small floating zoom controls (text font size / pdf page scale) -->
    <LinearLayout
        android:id="@+id/reader_fabs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="22dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/btn_fab_in"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_ring_btn_off"
            android:elevation="6dp"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/light_on_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reader_page_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="18dp"
            android:layout_marginBottom="22dp"
            android:background="@drawable/bg_solid_round"
            android:importantForAccessibility="no"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:elevation="6dp"
            android:gravity="center"
            android:textColor="@color/light_on_surface"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_fab_out"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_solid_round"
            android:elevation="6dp"
            android:gravity="center"
            android:text="&#8722;"
            android:textColor="@color/light_on_surface"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>

