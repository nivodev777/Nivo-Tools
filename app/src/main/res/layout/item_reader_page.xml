<?xml version="1.0" encoding="utf-8"?>
<!-- One rendered PDF page inside the reader's lazy page list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/item_page_img"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:background="@drawable/bg_solid_round"
        android:contentDescription="@null"
        android:padding="6dp" />

    <TextView
        android:id="@+id/item_page_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:alpha="0.65"
        android:textColor="@color/light_on_surface_variant"
        android:textSize="11sp" />

</LinearLayout>
